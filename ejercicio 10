using System;
using System.Threading;

class Program
{
    static void Main()
    {
        Console.Write("Ingresa la nota: ");
        int nota = Convert.ToInt32(Console.ReadLine());

        if (nota >= 90)
        {
            Console.WriteLine("A");
        }
        else if (nota >= 80)
        {
            Console.WriteLine("B");
        }
        else if (nota >= 70)
        {
            Console.WriteLine("C");
        }
        else
        {
            for (int i = 0; i < 5; i++)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("Mmm... necesitas mejorar.");
                Thread.Sleep(500);

                Console.Clear();

                Thread.Sleep(500);
            }

            Console.ResetColor();
        }
    }
}
